{
  "name": "veyrilo",
  "version": "1.0.0",
  "description": "Veyrilo - Minimalist Markdown Editor",
  "scripts": {
    "start": "npm run desktop:dev",
    "check": "for file in js/*.js scripts/*.mjs; do node --check \"$file\" || exit 1; done",
    "test": "npm run build:frontend && node --test test/*.test.js",
    "build:frontend": "node scripts/build-frontend.mjs",
    "desktop:dev": "npm run build:frontend && tauri dev",
    "desktop:build": "tauri build",
    "dist": "npm run desktop:build",
    "install:local": "npm run desktop:build && node scripts/install-local.mjs",
    "uninstall:local": "node scripts/uninstall-local.mjs"
  },
  "keywords": [
    "markdown",
    "editor",
    "tauri",
    "desktop"
  ],
  "author": "Utkucan-W",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "jsdom": "^30.0.1"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.14",
    "marked": "^15.0.12"
  }
}
