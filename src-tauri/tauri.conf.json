{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyrilo",
  "version": "1.1.0",
  "identifier": "app.veyrilo.editor",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Veyrilo",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "category": "Utility",
    "shortDescription": "A minimalist Markdown editor.",
    "longDescription": "Veyrilo is a minimalist Markdown editor with live preview and local file export. Thoughts, in flow."
  }
}
